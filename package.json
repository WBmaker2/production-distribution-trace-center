{
  "name": "production-distribution-trace-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "생산·유통 경로 추적소 — 초등 5~6학년 사회 정적 학습 앱",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "test:a11y": "vitest run tests/a11y",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-file-lines.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run test:a11y && npm run check:lines && npm run build && npm run test:release && npm run test:e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
